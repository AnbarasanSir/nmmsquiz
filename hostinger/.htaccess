# Hostinger .htaccess Configuration for NMMS Quiz App
# Combines Python WSGI Backend (/api/*) + React Vite SPA Frontend (/*)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Route all /api/ requests to the Python WSGI application
  # If running via Hostinger Python App Manager with Passenger:
  RewriteRule ^api/(.*)$ passenger_wsgi.py [QSA,L]

  # 2. Allow direct access to physical files (images, assets, json, js, css)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Route all other frontend URLs to index.html (React Single Page Application Fallback)
  RewriteRule ^ index.html [L]
</IfModule>

# MIME Types & UTF-8 Header Configuration
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType image/svg+xml .svg
</IfModule>

# Security Headers & GZIP Compression
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>
